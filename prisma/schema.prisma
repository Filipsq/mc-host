generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  passwordHash       String
  createdAt          DateTime           @default(now())
  // When the user accepted the terms (at sign-up); null for accounts made before there were any.
  termsAcceptedAt    DateTime?
  // Sessions that signed in before this are no longer accepted (see src/lib/session.ts).
  passwordChangedAt  DateTime?
  // The site's language the user last chose; emails are written in it.
  locale             String             @default("pl")
  // Can open the admin panel and every server's panel. Set on the server with deploy/admin.sh.
  admin              Boolean            @default(false)
  servers            Server[]
  payments           Payment[]
  passwordResets     PasswordReset[]
  supportChat        SupportChat?
  aiUsage            AiUsage[]
  // Friends' servers this user was let into (see src/lib/access.ts).
  memberships        ServerMember[]
  // Referrals (src/lib/referrals.ts): the code in the user's invite link, who invited them,
  // when they first paid enough for both to get free days, and the days waiting to be
  // added to one of their servers.
  referralCode       String?            @unique
  referredBy         User?              @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredById       String?
  referrals          User[]             @relation("Referrals")
  referralRewardedAt DateTime?
  bonusDays          Int                @default(0)
  // The site ran on Stripe test keys at first, so some checkouts took no money
  // (src/lib/testPayments.ts): when the user was told, and the days their first
  // real payment adds on top to make up for it.
  paymentNoticeAt    DateTime?
  apologyDays        Int                @default(0)
  // Phones and browsers that turned on notifications (src/lib/push.ts).
  pushSubscriptions  PushSubscription[]

  @@index([referredById])
}

// A browser's Web Push subscription, made when the user turns on notifications
// in the panel (most often in the app installed on their phone). Removed when
// they turn them off or the push service says it no longer exists.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// The notice admins show across the site (one row, id 1; empty text: none).
model Announcement {
  id        Int      @id @default(1)
  text      String   @default("")
  updatedAt DateTime @updatedAt
}

// One call to the AI (Claude), for the per-user and monthly limits and the
// admin panel's usage figures.
model AiUsage {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind         String // what it was for, e.g. "create"
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0) // estimated from the token counts and list prices
  ok           Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

// A user's conversation with the admins (the "Help" chat). One per user,
// created by its first message. The unread counters drive the badges and
// decide when to email: only the first unread message of a run sends one.
model SupportChat {
  userId        String           @id
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime         @default(now())
  lastFromStaff Boolean          @default(false)
  // Messages the user hasn't seen yet, and when they last had the chat open.
  userUnread    Int              @default(0)
  userReadAt    DateTime?
  // Messages no admin has seen yet, and when an admin last had the chat open.
  staffUnread   Int              @default(0)
  staffReadAt   DateTime?
  messages      SupportMessage[]

  @@index([lastMessageAt])
}

model SupportMessage {
  id        String      @id @default(cuid())
  chatId    String
  chat      SupportChat @relation(fields: [chatId], references: [userId], onDelete: Cascade)
  // Written by an admin (authorId) rather than by the chat's user.
  fromStaff Boolean     @default(false)
  authorId  String?
  body      String
  createdAt DateTime    @default(now())

  @@index([chatId, createdAt])
}

// A "forgot password" link. Only the hash of the link's token is stored.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

enum Edition {
  JAVA
  BEDROCK
  TERRARIA
}

enum Plan {
  FREE
  STARTER
  STANDARD
  PRO
}

enum ServerStatus {
  AWAITING_PAYMENT
  PROVISIONING
  RUNNING
  SLEEPING
  STOPPED
  SUSPENDED
}

model Server {
  id               String         @id @default(cuid())
  name             String
  edition          Edition        @default(JAVA)
  plan             Plan           @default(FREE)
  status           ServerStatus   @default(PROVISIONING)
  memoryMb         Int
  // The game machine it runs on: "main", or an extra machine from NODES (src/lib/nodes.ts).
  node             String         @default("main")
  version          String         @default("LATEST")
  // Game settings from the panel's Settings page (see src/lib/settings.ts).
  gameMode         String         @default("survival")
  difficulty       String         @default("easy") // Terraria: the world's classic, expert, master or journey
  motd             String         @default("") // empty: the server's name
  pvp              Boolean        @default(true) // Java only
  whitelist        Boolean        @default(false)
  whitelistPlayers String[]       @default([])
  // Java on Paper only: false lets in players without a bought Minecraft ("non-premium"),
  // who log in with a password through the AuthMe plugin.
  onlineMode       Boolean        @default(true)
  // Java on Paper only: Bedrock players (phones, consoles, Windows) join too, through the
  // Geyser plugin on the server's port over UDP.
  crossplay        Boolean        @default(false)
  // The world folder the server runs (the image's default if null), and the seed and
  // type it was made with (src/lib/worlds.ts). On Terraria the type is the world's size.
  level            String?
  levelSeed        String?
  levelType        String?
  // What the server runs: on Java vanilla (Paper), skyblock, oneblock, modpack, fabric, forge or neoforge
  // (src/lib/modpacks.ts); on Terraria vanilla, tshock or tmodloader (src/lib/terraria.ts).
  kind             String         @default("vanilla")
  // A mod pack's Modrinth project and the exact pack version players must install too.
  modpack          String?
  modpackSource    String? // where the pack comes from: null for Modrinth, or "curseforge"
  modpackTitle     String?
  modpackVersionId String?
  modpackVersion   String? // the pack version's number, e.g. "1.6.1"
  modpackLoader    String? // fabric, forge, neoforge or quilt
  // Modrinth project IDs of the plugins (Paper) or mods (mod loaders) the owner added (src/lib/plugins.ts);
  // on tModLoader, Steam Workshop IDs of its mods.
  plugins          String[]       @default([])
  // The list changed while the server ran; the container gets it on its next rebuild.
  pluginsPending   Boolean        @default(false)
  // Terraria only: the password players type to join; none if null.
  serverPassword   String?
  // Host port of the server: behind the router for Java, public for Bedrock (UDP) and Terraria (TCP).
  port             Int?           @unique
  // Java address is <subdomain>.<GAME_DOMAIN>, routed by hostname on port 25565.
  subdomain        String?        @unique
  // Paid plans are prepaid; the server is suspended once this passes.
  paidUntil        DateTime?
  // The paidUntil its owner was last reminded of, so each period gets one reminder.
  reminderSentFor  DateTime?
  // When its owner was told a suspended server will be deleted; cleared by a payment.
  // For a free server: told it will be deleted for nobody playing; cleared when someone plays.
  deletionWarnedAt DateTime?
  // When players were last seen on it (or when it was made); free servers nobody plays on are deleted.
  lastPlayedAt     DateTime       @default(now())
  payments         Payment[]
  owner            User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId          String
  // Friends the owner let into the server's panel.
  members          ServerMember[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([ownerId])
}

// A friend the owner let into a server's panel. Invited by email; linked to the
// account with that email as soon as there is one (src/lib/access.ts).
model ServerMember {
  id        String   @id @default(cuid())
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId  String
  email     String
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  // What they may do besides seeing the server and starting or stopping it.
  perms     String[] @default([])
  createdAt DateTime @default(now())

  @@unique([serverId, email])
  @@index([userId])
  @@index([email])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

// One Stripe Checkout payment buying `days` of `plan` for a server.
model Payment {
  id              String        @id @default(cuid())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  server          Server?       @relation(fields: [serverId], references: [id], onDelete: SetNull)
  serverId        String?
  plan            Plan
  days            Int
  amount          Int // in the currency's minor unit (grosze, cents)
  currency        String
  status          PaymentStatus @default(PENDING)
  stripeSessionId String?       @unique
  // The buyer asked for the server to start before the 14-day withdrawal period ends.
  startConsent    Boolean       @default(false)
  createdAt       DateTime      @default(now())
  paidAt          DateTime?

  @@index([userId])
  @@index([serverId])
}
