generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  createdAt       DateTime  @default(now())
  // When the user accepted the terms (at sign-up); null for accounts made before there were any.
  termsAcceptedAt DateTime?
  servers         Server[]
  payments        Payment[]
}

enum Edition {
  JAVA
  BEDROCK
}

enum Plan {
  FREE
  STARTER
  STANDARD
  PRO
}

enum ServerStatus {
  AWAITING_PAYMENT
  PROVISIONING
  RUNNING
  SLEEPING
  STOPPED
  SUSPENDED
}

model Server {
  id        String       @id @default(cuid())
  name      String
  edition   Edition      @default(JAVA)
  plan      Plan         @default(FREE)
  status    ServerStatus @default(PROVISIONING)
  memoryMb  Int
  version   String       @default("LATEST")
  // Host port of the server: behind the router for Java, public (UDP) for Bedrock.
  port      Int?         @unique
  // Java address is <subdomain>.<GAME_DOMAIN>, routed by hostname on port 25565.
  subdomain String?      @unique
  // Paid plans are prepaid; the server is suspended once this passes.
  paidUntil DateTime?
  payments  Payment[]
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([ownerId])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

// One Stripe Checkout payment buying `months` of `plan` for a server.
model Payment {
  id              String        @id @default(cuid())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  server          Server?       @relation(fields: [serverId], references: [id], onDelete: SetNull)
  serverId        String?
  plan            Plan
  months          Int
  amount          Int // in the currency's minor unit (grosze, cents)
  currency        String
  status          PaymentStatus @default(PENDING)
  stripeSessionId String?       @unique
  // The buyer asked for the server to start before the 14-day withdrawal period ends.
  startConsent    Boolean       @default(false)
  createdAt       DateTime      @default(now())
  paidAt          DateTime?

  @@index([userId])
  @@index([serverId])
}
