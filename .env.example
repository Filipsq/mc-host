DATABASE_URL="postgresql://mchost:mchost@localhost:5432/mchost"
# Generate with: npx auth secret
AUTH_SECRET="replace-me"
# Needed for `npm start` locally; on a real deploy set AUTH_URL instead.
AUTH_TRUST_HOST=true

# Node agent (see agent/README.md). Use the same token on both sides.
AGENT_URL="http://localhost:8081"
AGENT_TOKEN="replace-me-too"
# Java players join <address>.GAME_DOMAIN (point a wildcard DNS record *.GAME_DOMAIN
# at the game host). Bedrock players use GAME_HOST plus the server's port.
GAME_DOMAIN="localhost"
GAME_HOST="localhost"
# Ports handed out to servers. Must not include 25565 (the agent's router uses it).
PORT_RANGE_START=30000
PORT_RANGE_END=30999
# Plan memory (MB) all Minecraft servers may hold together; unset means no limit.
# The agent reads the same variable. deploy/setup.sh fills it in from the machine's RAM.
# MEMORY_LIMIT_MB=5120

# Public URL of this site, used for Stripe return links.
APP_URL="http://localhost:3000"
# Stripe. Use a restricted key (rk_test_… while testing) with write access to
# Checkout Sessions, Customers and Invoices only, rather than the full sk_ key. Turn on Card, BLIK
# and Przelewy24 in Dashboard → Settings → Payment methods. Webhook endpoint:
# /api/stripe/webhook (events: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# checkout.session.expired, charge.refunded, charge.dispute.created). Fill in
# your business details in Dashboard → Settings → Invoice template so invoices
# carry them. Never commit real keys.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Shared secret for the billing job: GET /api/cron/billing every 5 minutes
# with "Authorization: Bearer $CRON_SECRET".
CRON_SECRET="replace-me-three"
